# Copy to .env and fill in. Everything is optional: with nothing set, the app
# still runs (pricing/compliance are deterministic, document Q&A falls back to
# quoting the best-matching sentences, and logging to Supabase is off).

# --- LLM (Gemini) -----------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15
# Second LLM pass that reviews document answers. Rule checks always run.
LLM_CRITIC=true

# --- OpenAI (fallback LLM) -----------------------------------------------------
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4.1-mini

# Providers are tried in this order; if one fails or is rate-limited, the next answers.
LLM_PROVIDERS=gemini,openai

# --- Supabase (optional audit log of answers + lead scores) -------------------
# Project Settings > API
SUPABASE_URL=
# Server-side only - never ship this key to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection (only for scripts/load_leads.py) ---------------------
# Project Settings > Database > Connection string > URI (session pooler works)
DATABASE_URL=
